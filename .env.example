# Copy to .env and `source .env`. Everything is optional: with no keys the
# copilot runs on the offline mock provider.

# Chat model: mock | openai | anthropic | gemini | ollama
COPILOT_PROVIDER=mock
# COPILOT_MODEL=gpt-4o-mini            # or claude-sonnet-4-5, gemini-2.5-flash, llama3.2

# Embeddings: mock | openai | ollama | cohere
COPILOT_EMBED_PROVIDER=mock
# COPILOT_EMBED_MODEL=text-embedding-3-small   # or nomic-embed-text (ollama)

# Vector store: memory | qdrant | chroma
COPILOT_VECTORSTORE=memory
# QDRANT_URL=http://localhost:6333
# CHROMA_URL=http://localhost:8000

# Retrieval
COPILOT_HYBRID=true
COPILOT_TOP_K=5
# COPILOT_MIN_SCORE=0.25

# Provider keys
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# COHERE_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Agent tools (defaults: fake cluster when provider=mock)
# COPILOT_FAKE_KUBECTL=1
# COPILOT_KUBE_CONTEXT=prod-us-east-1
# COPILOT_NAMESPACES=payments,platform
# PROMETHEUS_URL=http://localhost:9090
